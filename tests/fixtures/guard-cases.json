				{ "write": { ".flow/contracts/demo.md": "# Contract\nB\n" } },
				{ "approve": [{ "kind": "contract", "path": ".flow/contracts/demo.md" }], "scope": "demo" },
				{ "status": "demo", "expect": { "contract": "current", "plan": "missing" } },
				{ "dispatch": { "role": "executor", "brief": "Flow gate:\n- Scope: demo\n- Contract: .flow/contracts/demo.md\n- Plan: .flow/plans/demo/PLAN.md\n\nBuild it." }, "expect": "deny", "reason": "no recorded plan approval" }
			]
		},
		{
