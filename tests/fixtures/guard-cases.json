				{ "dispatch": { "role": "mechanical", "brief": "Flow gate:\n- Scope: other\n- Contract: .flow/contracts/other.md\n- Plan: .flow/plans/other/PLAN.md\n\nRename it." }, "expect": "deny", "reason": "no recorded plan approval" },
				{ "dispatch": { "role": "mechanical", "brief": "Rename the helper." }, "expect": "allow" },
				{ "dispatch": { "role": "reader", "brief": "Find the helper." }, "expect": "allow" }
			]
