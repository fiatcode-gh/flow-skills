{
	"secretRead": [
		{ "path": ".env", "refuse": true, "name": ".env" },
		{ "path": "app/.env.local", "refuse": true, "name": ".env.local" },
		{ "path": "config/credentials.json", "refuse": true, "name": "credentials.json" },
		{ "path": "sandbox-credentials.md", "refuse": true, "name": "sandbox-credentials.md" },
		{ "path": "keys/id_rsa", "refuse": true, "name": "id_rsa" },
		{ "path": "certs/server.pem", "refuse": true, "name": "server.pem" },
		{ "path": "certs/server.key", "refuse": true, "name": "server.key" },
		{ "path": "mcp.json", "refuse": true, "name": "mcp.json" },
		{ "path": "app/.mcp.json", "refuse": true, "name": ".mcp.json" },
		{ "path": "~/.config/opencode/service.json", "refuse": true, "name": "service.json" },
		{ "path": "~/.aws/credentials", "refuse": true, "name": "credentials" },
		{ "path": "./config/../.env", "refuse": true, "name": ".env" },
		{ "path": "sites/app.example.com/.env", "refuse": true, "name": ".env" },
		{ "path": ".env.example", "refuse": false },
		{ "path": "app/.env.sample", "refuse": false },
		{ "path": "secrets/credentials.sample.yml", "refuse": false },
		{ "path": "src/auth/credentials.ts", "refuse": false },
		{ "path": "keys/id_rsa.pub", "refuse": false },
		{ "path": "certs/fullchain.pem", "refuse": false },
		{ "path": "omp/mcp.example.json", "refuse": false },
		{ "path": "service.json", "refuse": false },
		{ "path": "README.md", "refuse": false }
	],
	"secretGrep": [
		{ "dir": "src", "glob": ".env*", "refuse": true },
		{ "dir": "config/.env", "glob": null, "refuse": true, "name": ".env" },
		{ "dir": ".", "glob": "*credentials*.json", "refuse": true },
		{ "dir": "keys", "glob": "id_rsa*", "refuse": true },
		{ "dir": "certs", "glob": "*.pem", "refuse": true },
		{ "dir": "src", "glob": "*.ts", "refuse": false },
		{ "dir": ".", "glob": ".env.example", "refuse": false },
		{ "dir": "docs", "glob": null, "refuse": false }
	],
	"secretShell": [
		{ "command": "cat .env", "refuse": true, "name": ".env" },
		{ "command": "grep -r TOKEN .env", "refuse": true, "name": ".env" },
		{ "command": ". ./.env", "refuse": true, "name": ".env" },
		{ "command": "source .env && env", "refuse": true, "name": ".env" },
		{ "command": "head -n 5 config/credentials.yml", "refuse": true, "name": "credentials.yml" },
		{ "command": "python -c \"print(open('.env').read())\"", "refuse": true, "name": ".env" },
		{ "command": "git diff -- .env", "refuse": true, "name": ".env" },
		{ "command": "cat ~/.config/opencode/service.json", "refuse": true, "name": "service.json" },
		{ "command": "cat < .env", "refuse": true, "name": ".env" },
		{ "command": "tr -d x < .env", "refuse": true, "name": ".env" },
		{ "command": "base64 keys/id_rsa", "refuse": true, "name": "id_rsa" },
		{ "command": "jq . mcp.json", "refuse": true, "name": "mcp.json" },
		{ "command": "sed -n 1p app/.env.local", "refuse": true, "name": ".env.local" },
		{ "command": "cat .env.example", "refuse": false },
		{ "command": "grep .env README.md", "refuse": false },
		{ "command": "( set -a; . ./.env >/dev/null 2>&1; set +a; exec ./run )", "refuse": false },
		{ "command": "docker run --env-file .env app", "refuse": false },
		{ "command": "echo hi > .env", "refuse": false },
		{ "command": "cat notes.txt > .env", "refuse": false },
		{ "command": "ls -la .env", "refuse": false },
		{ "command": "cp .env .env.bak", "refuse": false },
		{ "command": "cat keys/id_rsa.pub", "refuse": false },
		{ "command": "test -f .env && echo yes", "refuse": false },
		{ "command": "cat README.md", "refuse": false }
	],
	"runtimeShell": [
		{ "command": "printf x >.flow/runtime/a", "refuse": { "omp": false, "opencode": true, "claude-code": true } },
		{ "command": ">>.flow/runtime/approvals.log", "refuse": { "omp": false, "opencode": true, "claude-code": true } },
		{ "command": "2>.flow/runtime/a", "refuse": { "omp": false, "opencode": true, "claude-code": true } },
		{ "command": "dd of=.flow/runtime/approvals.log", "refuse": { "omp": false, "opencode": true, "claude-code": true } },
		{ "command": "python3 -c \"open('.flow/runtime/approvals.log','w')\"", "refuse": { "omp": false, "opencode": true, "claude-code": true } },
		{ "command": "node -e \"require('fs').writeFileSync('.flow/runtime/approvals.log','x')\"", "refuse": { "omp": false, "opencode": true, "claude-code": true } },
		{ "command": "curl -o.flow/runtime/a https://example.invalid", "refuse": { "omp": false, "opencode": true, "claude-code": true } },
		{ "command": "cp x --target-directory=.flow/runtime", "refuse": { "omp": false, "opencode": true, "claude-code": true } },
		{ "command": "cd .flow;printf x>runtime/a", "refuse": { "omp": false, "opencode": false, "claude-code": true } },
		{ "command": "curl -o.flow/'runtime'/a https://example.invalid", "refuse": { "omp": false, "opencode": false, "claude-code": true } },
		{ "command": "printf x >.flow/contracts/a", "refuse": { "omp": false, "opencode": false, "claude-code": false } },
		{ "command": "cat .flow/contracts/runtime.md", "refuse": { "omp": false, "opencode": false, "claude-code": false } }
	],
	"scenarios": [
		{
			"name": "gate/planner-missing",
			"unborn": false,
			"steps": [
				{ "write": { ".flow/contracts/demo.md": "# Contract\nA\n" } },
				{ "dispatch": { "role": "planner", "brief": "Flow gate:\n- Scope: demo\n- Contract: .flow/contracts/demo.md\n\nPlan it." }, "expect": "deny", "reason": "no recorded contract approval" }
			]
		},
		{
			"name": "gate/planner-current",
			"unborn": false,
			"steps": [
				{ "write": { ".flow/contracts/demo.md": "# Contract\nA\n" } },
				{ "approve": [{ "kind": "contract", "path": ".flow/contracts/demo.md" }], "scope": "demo" },
				{ "dispatch": { "role": "planner", "brief": "Flow gate:\n- Scope: demo\n- Contract: .flow/contracts/demo.md\n\nPlan it." }, "expect": "allow" },
				{ "dispatch": { "role": "planner", "brief": "Flow gate:\n- Scope: `demo`\n- Contract: `.flow/contracts/demo.md`\n\nPlan it." }, "expect": "allow" },
				{ "dispatch": { "role": "planner", "brief": "Flow gate:\n- Scope: \"demo\"\n- Contract: '.flow/contracts/demo.md'\n\nPlan it." }, "expect": "allow" },
				{ "dispatch": { "role": "planner", "brief": "flow gate:\n- Scope: demo\n- Contract: .flow/contracts/demo.md\n\nPlan it." }, "expect": "allow" },
				{ "dispatch": { "role": "planner", "brief": "Flow gate:\r\n- Scope: demo\r\n- Contract: .flow/contracts/demo.md\r\n\r\nPlan it.\r\n" }, "expect": "allow" }
			]
		},
		{
			"name": "gate/planner-stale",
			"unborn": false,
			"steps": [
				{ "write": { ".flow/contracts/demo.md": "# Contract\nA\n" } },
				{ "approve": [{ "kind": "contract", "path": ".flow/contracts/demo.md" }], "scope": "demo" },
				{ "write": { ".flow/contracts/demo.md": "# Contract\nB\n" } },
				{ "dispatch": { "role": "planner", "brief": "Flow gate:\n- Scope: demo\n- Contract: .flow/contracts/demo.md\n\nPlan it." }, "expect": "deny", "reason": "contract artifact changed after approval" }
			]
		},
		{
			"name": "gate/planner-wrong-path",
			"unborn": false,
			"steps": [
				{ "write": { ".flow/contracts/demo.md": "# Contract\nA\n" } },
				{ "approve": [{ "kind": "contract", "path": ".flow/contracts/demo.md" }], "scope": "demo" },
				{ "write": { ".flow/contracts/other.md": "# Contract\nA\n" } },
				{ "dispatch": { "role": "planner", "brief": "Flow gate:\n- Scope: demo\n- Contract: .flow/contracts/other.md\n\nPlan it." }, "expect": "deny", "reason": "contract path is not the approved artifact" }
			]
		},
		{
			"name": "gate/malformed",
			"unborn": false,
			"steps": [
				{ "write": { ".flow/contracts/demo.md": "# Contract\nA\n" } },
				{ "approve": [{ "kind": "contract", "path": ".flow/contracts/demo.md" }], "scope": "demo" },
				{ "dispatch": { "role": "planner", "brief": "Plan the demo contract." }, "expect": "deny", "reason": "must include Flow gate with Scope and Contract" },
				{ "dispatch": { "role": "planner", "brief": "Flow gate:\n- Scope: demo\n\nPlan it." }, "expect": "deny", "reason": "must include Flow gate with Scope and Contract" },
				{ "dispatch": { "role": "planner", "brief": "Flow gate:\n- Scope: demo\nThe contract follows.\n- Contract: .flow/contracts/demo.md\n\nPlan it." }, "expect": "deny", "reason": "must include Flow gate with Scope and Contract" }
			]
		},
		{
			"name": "gate/later-bullet-not-read",
			"unborn": false,
			"steps": [
				{ "write": { ".flow/contracts/demo.md": "# Contract\nA\n" } },
				{ "approve": [{ "kind": "contract", "path": ".flow/contracts/demo.md" }], "scope": "demo" },
				{ "dispatch": { "role": "planner", "brief": "Flow gate:\n- Scope: demo\n- Contract: .flow/contracts/demo.md\nNotes for later:\n- Contract: .flow/contracts/other.md\n\nPlan it." }, "expect": "allow" }
			]
		},
		{
			"name": "gate/writer-plan",
			"unborn": false,
			"steps": [
				{ "write": { ".flow/contracts/demo.md": "# Contract\nA\n", ".flow/plans/demo/PLAN.md": "# Plan\ntask\n## In-scope amendments\n" } },
				{ "approve": [{ "kind": "contract", "path": ".flow/contracts/demo.md" }, { "kind": "plan", "path": ".flow/plans/demo/PLAN.md" }], "scope": "demo" },
				{ "dispatch": { "role": "executor", "brief": "Flow gate:\n- Scope: demo\n- Contract: .flow/contracts/demo.md\n- Plan: .flow/plans/demo/PLAN.md\n\nBuild it." }, "expect": "allow" },
				{ "dispatch": { "role": "implementer", "brief": "Flow gate:\n- Scope: demo\n- Contract: .flow/contracts/demo.md\n- Plan: .flow/plans/demo/PLAN.md\n\nBuild it." }, "expect": "allow" },
				{ "dispatch": { "role": "executor", "brief": "Flow gate:\n- Scope: demo\n- Contract: .flow/contracts/demo.md\n\nBuild it." }, "expect": "deny", "reason": "must include Flow gate with Scope, Contract, and Plan" },
				{ "write": { ".flow/plans/demo/PLAN.md": "# Plan\ntask changed\n## In-scope amendments\n" } },
				{ "dispatch": { "role": "executor", "brief": "Flow gate:\n- Scope: demo\n- Contract: .flow/contracts/demo.md\n- Plan: .flow/plans/demo/PLAN.md\n\nBuild it." }, "expect": "deny", "reason": "plan artifact changed after approval" }
			]
		},
		{
			"name": "gate/plan-none",
			"unborn": false,
			"steps": [
				{ "write": { ".flow/contracts/demo.md": "# Contract\nA\n", ".flow/contracts/other.md": "# Contract\nO\n" } },
				{ "approve": [{ "kind": "contract", "path": ".flow/contracts/demo.md" }, { "kind": "implementation", "path": ".flow/contracts/demo.md" }], "scope": "demo" },
				{ "dispatch": { "role": "implementer", "brief": "Flow gate:\n- Scope: demo\n- Contract: .flow/contracts/demo.md\n- Plan: NONE\n\nBuild it." }, "expect": "allow" },
				{ "dispatch": { "role": "implementer", "brief": "Flow gate:\n- Scope: demo\n- Contract: .flow/contracts/demo.md\n- Plan: none\n\nBuild it." }, "expect": "allow" },
				{ "approve": [{ "kind": "contract", "path": ".flow/contracts/other.md" }], "scope": "other" },
				{ "dispatch": { "role": "implementer", "brief": "Flow gate:\n- Scope: other\n- Contract: .flow/contracts/other.md\n- Plan: NONE\n\nBuild it." }, "expect": "deny", "reason": "no recorded implementation approval" }
			]
		},
		{
			"name": "gate/mechanical",
			"unborn": false,
			"steps": [
				{ "write": { ".flow/contracts/demo.md": "# Contract\nA\n", ".flow/plans/demo/PLAN.md": "# Plan\ntask\n", ".flow/contracts/other.md": "# Contract\nO\n" } },
				{ "approve": [{ "kind": "contract", "path": ".flow/contracts/demo.md" }, { "kind": "plan", "path": ".flow/plans/demo/PLAN.md" }], "scope": "demo" },
				{ "approve": [{ "kind": "contract", "path": ".flow/contracts/other.md" }], "scope": "other" },
