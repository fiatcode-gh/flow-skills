{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "git push*": "ask",
      "git -C * push*": "ask",
      "git -c * push*": "ask",
      "env * git push*": "ask",
      "env * gh *": "ask",
      "gh pr create*": "ask",
      "gh pr merge*": "ask",
      "gh pr review*": "ask",
      "gh pr comment*": "ask",
      "gh pr edit*": "ask",
      "gh pr close*": "ask",
      "gh pr ready*": "ask",
      "gh pr reopen*": "ask",
      "gh issue comment*": "ask",
      "gh issue create*": "ask",
      "gh issue close*": "ask",
      "gh issue edit*": "ask",
      "gh release create*": "ask",
      "gh release edit*": "ask",
      "gh release upload*": "ask",
      "gh release delete*": "ask",
      "gh repo edit*": "ask",
      "gh repo delete*": "ask",
      "gh secret set*": "ask",
      "gh workflow run*": "ask",
      "gh api -X*": "ask",
      "gh api * -X*": "ask",
      "gh api --method*": "ask",
      "gh api * --method*": "ask",
      "gh api -f*": "ask",
      "gh api * -f*": "ask",
      "gh api -F*": "ask",
      "gh api * -F*": "ask",
      "gh api --field*": "ask",
      "gh api * --field*": "ask",
      "gh api --raw-field*": "ask",
      "gh api * --raw-field*": "ask",
      "gh api --input*": "ask",
      "gh api * --input*": "ask",
      "*.flow/runtime*": "ask"
    },
    "read": {
      ".env*": "deny",
      "*/.env*": "deny",
      "mcp.json": "deny",
      "*/mcp.json": "deny",
      ".mcp.json": "deny",
      "*/.mcp.json": "deny",
      "*opencode/service.json": "deny",
      "*credentials": "deny",
      "*credentials*.json": "deny",
      "*credentials*.yml": "deny",
      "*credentials*.yaml": "deny",
      "*credentials*.toml": "deny",
      "*credentials*.ini": "deny",
      "*credentials*.cfg": "deny",
      "*credentials*.conf": "deny",
      "*credentials*.properties": "deny",
      "*credentials*.txt": "deny",
      "*credentials*.md": "deny",
      "*credentials*.csv": "deny",
      "*credentials*.xml": "deny",
      "*credentials*.env": "deny",
      "*id_rsa": "deny",
      "*id_dsa": "deny",
      "*id_ecdsa": "deny",
      "*id_ed25519": "deny",
      "*id_ecdsa_sk": "deny",
      "*id_ed25519_sk": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.ppk": "deny",
      "*.pub": "allow",
      "*.example": "allow",
      "*.sample": "allow",
      "*.example.json": "allow",
      "*.example.yml": "allow",
      "*.example.yaml": "allow",
      "*.example.toml": "allow",
      "*.sample.json": "allow",
      "*.sample.yml": "allow",
      "*.sample.yaml": "allow",
      "*.sample.toml": "allow"
    }
  }
}
